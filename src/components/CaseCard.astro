---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'casos'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { title, client, industry, summary, cover, coverAlt, results } = entry.data;
---

<article class="card overflow-hidden p-0">
  <Image
    src={cover}
    alt={coverAlt}
    widths={[400, 800, 1200]}
    sizes="(min-width: 768px) 50vw, 100vw"
  />
  <div class="p-6">
    <p class="text-sm font-medium text-muted">
      {client} · {industry}
    </p>
    <Heading class="mt-2 text-xl">{title}</Heading>
    <p class="mt-3 text-muted">{summary}</p>
    {results.length > 0 && (
      <ul class="mt-4 list-disc space-y-1 pl-5">
        {results.map((result) => (
          <li>{result}</li>
        ))}
      </ul>
    )}
  </div>
</article>
