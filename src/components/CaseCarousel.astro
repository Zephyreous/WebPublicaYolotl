---
import type { CollectionEntry } from 'astro:content';
import CaseCard from './CaseCard.astro';

/**
 * Carrusel accesible de casos (patrón WAI-ARIA "carousel").
 * - Sin JS: pista horizontal con scroll-snap (deslizable con el dedo o la rueda).
 * - Con JS: botones anterior/siguiente, puntos, flechas del teclado y anuncio del caso actual.
 * - Sin reproducción automática (WCAG 2.2.2).
 */
interface Props {
  entries: CollectionEntry<'casos'>[];
  label?: string;
  headingLevel?: 'h2' | 'h3';
}

const { entries, label = 'Casos de estudio', headingLevel = 'h3' } = Astro.props;
const id = `carrusel-${label
  .toLowerCase()
  .normalize('NFD')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')}`;
const total = entries.length;
---

<div
  class="carousel"
  role="region"
  aria-roledescription="carrusel"
  aria-label={label}
  data-carousel
>
  <ul id={id} class="carousel-track" data-track>
    {entries.map((entry, i) => (
      <li
        class="carousel-slide"
        role="group"
        aria-roledescription="diapositiva"
        aria-label={`${i + 1} de ${total}`}
        data-slide
      >
        <CaseCard entry={entry} headingLevel={headingLevel} />
      </li>
    ))}
  </ul>

  {total > 1 && (
    <div class="carousel-controls mt-6 flex items-center justify-between gap-4" data-controls>
      <div class="flex gap-2" role="group" aria-label="Elegir caso">
        {entries.map((entry, i) => (
          <button
            type="button"
            class="carousel-dot"
            aria-label={`Ir al caso ${i + 1}: ${entry.data.title}`}
            aria-controls={id}
            data-dot={i}
          />
        ))}
      </div>
      <div class="flex gap-2">
        <button
          type="button"
          class="carousel-arrow"
          aria-label="Caso anterior"
          aria-controls={id}
          data-prev
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M19 12H5M11 6l-6 6 6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
        <button
          type="button"
          class="carousel-arrow"
          aria-label="Caso siguiente"
          aria-controls={id}
          data-next
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  )}
  <p class="sr-only" aria-live="polite" data-status></p>
</div>

<style>
  .carousel-track {
    position: relative; /* offsetLeft de cada caso queda relativo a la pista */
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 88%;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-2) 0 var(--space-4);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  @media (min-width: 768px) {
    .carousel-track {
      grid-auto-columns: calc((100% - var(--space-6)) / 2);
      gap: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .carousel-track {
      scroll-behavior: smooth;
    }
  }

  .carousel-slide {
    scroll-snap-align: start;
    /* Espacio para que la tarjeta pueda elevarse en hover sin recortarse. */
    padding-top: 4px;
  }

  .carousel-slide > :global(*) {
    height: 100%;
  }

  /* Los controles solo tienen sentido con JS. */
  :global(html:not(.js)) .carousel-controls {
    display: none;
  }

  .carousel-arrow {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-full);
    color: var(--color-text);
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .carousel-arrow:hover:not(:disabled) {
    background-color: var(--color-secondary-hover-bg);
    border-color: var(--color-secondary-hover-bg);
    color: var(--color-secondary-hover-text);
  }

  .carousel-arrow:active:not(:disabled) {
    transform: scale(0.94);
  }

  .carousel-arrow:disabled {
    border-color: var(--color-border);
    color: var(--color-text-muted);
    cursor: not-allowed;
  }

  /* Puntos: área táctil de 24px aunque el punto visible sea más pequeño. */
  .carousel-dot {
    position: relative;
    width: 24px;
    height: 24px;
  }

  .carousel-dot::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-full);
    transition:
      inset var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .carousel-dot[aria-current='true']::before {
    inset: 6px;
    background-color: var(--color-border-accent);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    if (!track || slides.length < 2) continue;

    let current = 0;
    // Mientras dura un desplazamiento iniciado por botones o puntos, no se recalcula el índice:
    // con dos casos visibles, el último no puede quedar a la izquierda y se perdería la selección.
    let programmatic = false;
    let settle: number | undefined;

    const atStart = () => track.scrollLeft <= 2;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

    const update = (index: number, announce = false) => {
      current = index;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
      if (prev) prev.disabled = atStart();
      if (next) next.disabled = atEnd();
      if (announce && status) status.textContent = `Caso ${index + 1} de ${slides.length}`;
    };

    const goTo = (index: number) => {
      const target = Math.max(0, Math.min(index, slides.length - 1));
      const left = Math.min(slides[target]!.offsetLeft, track.scrollWidth - track.clientWidth);
      // Si ya está en esa posición no habrá evento scroll que limpie la bandera.
      programmatic = Math.abs(left - track.scrollLeft) > 2;
      track.scrollTo({ left });
      update(target, true);
    };

    // Deslizamiento manual: el caso actual es el más cercano al borde izquierdo
    // (o el último, si ya no se puede avanzar más).
    const indexFromScroll = () => {
      if (atEnd()) return slides.length - 1;
      let nearest = 0;
      slides.forEach((slide, i) => {
        const distance = Math.abs(slide.offsetLeft - track.scrollLeft);
        if (distance < Math.abs(slides[nearest]!.offsetLeft - track.scrollLeft)) nearest = i;
      });
      return nearest;
    };

    track.addEventListener(
      'scroll',
      () => {
        update(current);
        window.clearTimeout(settle);
        settle = window.setTimeout(() => {
          if (!programmatic) update(indexFromScroll());
          programmatic = false;
        }, 150);
      },
      { passive: true },
    );
    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(current + 1);
      }
    });

    update(0);
  }
</script>
