---
import Logo from './Logo.astro';
interface Props {
  title: string;
  summary: string;
  features?: string[];
  headingLevel?: 'h2' | 'h3';
}

const { title, summary, features = [], headingLevel: Heading = 'h3' } = Astro.props;
---

<article
  class="card card-hover flex h-full flex-col border-t-4"
  data-reveal
  style="border-top-color: var(--color-border-accent);"
>
  <div class="icon-chip mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-bg">
    <Logo variant="isotipo" width={22} withClearspace={false} alt="" />
  </div>
  <Heading class="text-xl">{title}</Heading>
  <p class="mt-3 text-muted">{summary}</p>
  {features.length > 0 && (
    <ul class="mt-4 list-disc space-y-1 pl-5">
      {features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
  )}
  <slot />
</article>
