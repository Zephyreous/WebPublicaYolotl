---
import { Image } from 'astro:assets';
import ventaImg from '@/assets/placeholders/pos-punto-de-venta.png';
import inventarioImg from '@/assets/placeholders/pos-inventario.png';
import iaImg from '@/assets/placeholders/pos-ia.png';

interface Props {
  /** compact: resumen para la página de inicio, sin capturas ni precio. */
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { compact = false, headingLevel: Heading = 'h2' } = Astro.props;

const modules = [
  {
    title: 'Punto de venta',
    description:
      'Cobro de refacciones y mano de obra, emisión de tickets digitales, cortes de caja y métodos de pago mixtos.',
    image: ventaImg,
    alt: 'Captura de la pantalla de cobro del POS',
  },
  {
    title: 'Control de inventario',
    description:
      'Gestión inteligente de refacciones, alertas de existencias mínimas, catálogo de proveedores y entradas automáticas.',
    image: inventarioImg,
    alt: 'Captura del módulo de inventario de refacciones',
  },
  {
    title: 'Asistente con IA',
    description:
      'Sugerencias de compra oportunas, diagnóstico técnico asistido y reportes conversacionales sobre las ventas del taller.',
    image: iaImg,
    alt: 'Captura del asistente con inteligencia artificial',
  },
];
---

<div class="grid gap-6 md:grid-cols-3">
  {modules.map((module) => (
    <article class="card flex flex-col">
      {!compact ? (
        <Image
          src={module.image}
          alt={module.alt}
          widths={[400, 800]}
          sizes="(min-width: 768px) 33vw, 100vw"
          class="mb-4 rounded-md"
        />
      ) : (
        <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-bg">
          <img src="/brand/Isotipo.svg" width="22" height="22" alt="" aria-hidden="true" />
        </div>
      )}
      <Heading class="text-xl">{module.title}</Heading>
      <p class="mt-2 text-muted">{module.description}</p>
    </article>
  ))}
</div>

{!compact && (
  <section class="card mt-8 md:flex md:items-center md:justify-between" aria-labelledby="precio">
    <div class="flex items-start gap-4">
      <img
        src="/brand/Icono.svg"
        width="48"
        height="48"
        alt=""
        class="hidden sm:block rounded-xl shrink-0"
        aria-hidden="true"
      />
      <div>
        <h2 id="precio" class="text-2xl">
          Precio
        </h2>
        <p class="tabular mt-2 text-3xl font-semibold">
          $<span class="todo">TODO</span> MXN <span class="text-base text-muted">/ mes</span>
        </p>
        <p class="mt-1 text-sm text-muted">
          Planes accesibles diseñados para talleres independientes y cadenas de servicio.
        </p>
      </div>
    </div>
    <a href="/contacto" class="btn-cta mt-6 md:mt-0">
      Pide una demo
    </a>
  </section>
)}
