---
/**
 * Logo de Yolotl Labs.
 * - Basado en los SVG oficiales de marca (viewBox 520x180 para logo completo, 200x200 isotipo, 512x512 icono).
 * - Por debajo de 110px de ancho se usa el isotipo (mínimo 16x16).
 * - Área de respeto: padding proporcional a la altura de la "o" del wordmark (ratio 0.22).
 * - Sin sombras, biseles ni efectos neón, preservando proporciones originales.
 */
interface Props {
  /** auto e isotipo cambian con el tema; positivo, negativo e icono son fijos. */
  variant?: 'auto' | 'positivo' | 'negativo' | 'isotipo' | 'icono';
  /** Ancho en px del logo completo o del icono/isotipo. */
  width?: number;
  class?: string;
  withClearspace?: boolean;
  alt?: string;
}

const {
  variant = 'auto',
  width = 160,
  class: className,
  withClearspace = true,
  alt = 'Yolotl Labs',
} = Astro.props;

const MIN_FULL_WIDTH = 110;
const MIN_ISOTIPO = 16;
// Proporción oficial del SVG completo (520x180):
const FULL_RATIO = 180 / 520;
// Área de respeto oficial (altura de la "O"):
const CLEARSPACE_RATIO = 0.22;

const useIcono = variant === 'icono';
const useIsotipo = variant === 'isotipo' || (!useIcono && width < MIN_FULL_WIDTH);
const isSquare = useIsotipo || useIcono;

const w = isSquare ? Math.max(width, MIN_ISOTIPO) : width;
const h = isSquare ? w : Math.round(w * FULL_RATIO);
const clearspace = withClearspace ? Math.round(h * CLEARSPACE_RATIO) : 0;

// Los colores del sprite son variables CSS por tema (global.css). Las variantes fijas las
// sobrescriben en línea. El isotipo siempre sigue el tema, como en los SVG oficiales.
const fixedColors =
  variant === 'negativo'
    ? '--logo-wing: var(--yolotl-ivory); --logo-core: var(--yolotl-navy); --logo-eye: var(--yolotl-ivory); --logo-wordmark: var(--yolotl-ivory);'
    : variant === 'positivo'
      ? '--logo-wing: var(--yolotl-navy); --logo-core: var(--yolotl-ivory); --logo-eye: var(--yolotl-navy); --logo-wordmark: var(--yolotl-navy);'
      : '';

const style =
  [clearspace > 0 ? `padding: ${clearspace}px;` : '', fixedColors].filter(Boolean).join(' ') ||
  undefined;

// Sprite en línea (src/components/BrandSprite.astro), insertado una vez en BaseLayout.
const symbolId = useIsotipo ? 'yl-isotipo' : 'yl-logo';
const viewBox = useIsotipo ? '0 0 200 200' : '0 0 520 180';
---

<span class:list={['logo', className]} style={style}>
  {useIcono ? (
    <img src="/brand/Icono.svg" width={w} height={h} alt={alt} />
  ) : (
    <svg
      viewBox={viewBox}
      width={w}
      height={h}
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
      focusable="false"
      class="logo-svg"
    >
      <use href={`#${symbolId}`}></use>
    </svg>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    line-height: 0;
    align-items: center;
    justify-content: center;
  }

  .logo img {
    display: block;
    max-width: none;
    height: auto;
  }

  /* El sprite conserva el tamaño exacto de los atributos width/height (sin sombras ni filtros). */
  .logo-svg {
    display: block;
    max-width: none;
  }
</style>
