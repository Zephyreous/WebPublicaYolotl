---
/**
 * Logo de Yolotl Labs.
 * - Basado en los SVG oficiales de marca (viewBox 520x180 para logo completo, 200x200 isotipo, 512x512 icono).
 * - Por debajo de 110px de ancho se usa el isotipo (mínimo 16x16).
 * - Área de respeto: padding proporcional a la altura de la "o" del wordmark (ratio 0.22).
 * - Sin sombras, biseles ni efectos neón, preservando proporciones originales.
 */
interface Props {
  /** auto e isotipo cambian con el tema; positivo, negativo e icono son fijos. */
  variant?: 'auto' | 'positivo' | 'negativo' | 'isotipo' | 'icono';
  /** Ancho en px del logo completo o del icono/isotipo. */
  width?: number;
  class?: string;
  withClearspace?: boolean;
  alt?: string;
}

const {
  variant = 'auto',
  width = 160,
  class: className,
  withClearspace = true,
  alt = 'Yolotl Labs',
} = Astro.props;

const MIN_FULL_WIDTH = 110;
const MIN_ISOTIPO = 16;
// Proporción oficial del SVG completo (520x180):
const FULL_RATIO = 180 / 520;
// Área de respeto oficial (altura de la "O"):
const CLEARSPACE_RATIO = 0.22;

const useIcono = variant === 'icono';
const useIsotipo = variant === 'isotipo' || (!useIcono && width < MIN_FULL_WIDTH);
const isSquare = useIsotipo || useIcono;

const w = isSquare ? Math.max(width, MIN_ISOTIPO) : width;
const h = isSquare ? w : Math.round(w * FULL_RATIO);
const clearspace = withClearspace ? Math.round(h * CLEARSPACE_RATIO) : 0;

// [fondo oscuro, fondo claro]. El isotipo también cambia: el ala izquierda es Blanco Hueso
// en la versión oscura y se perdería sobre ivory.
const [srcDark, srcLight] = useIcono
  ? ['/brand/Icono.svg', '/brand/Icono.svg']
  : useIsotipo
    ? ['/brand/isotipo.svg', '/brand/isotipo-light.svg']
    : variant === 'negativo'
      ? ['/brand/Log+TextDark.svg', '/brand/Log+TextDark.svg']
      : variant === 'positivo'
        ? ['/brand/Log+TextLight.svg', '/brand/Log+TextLight.svg']
        : ['/brand/Log+TextDark.svg', '/brand/Log+TextLight.svg'];
---

<span
  class:list={['logo', className]}
  style={clearspace > 0 ? `padding: ${clearspace}px;` : undefined}
>
  {srcDark === srcLight ? (
    <img src={srcDark} width={w} height={h} alt={alt} />
  ) : (
    <>
      <img class="logo-on-dark" src={srcDark} width={w} height={h} alt={alt} />
      <img class="logo-on-light" src={srcLight} width={w} height={h} alt={alt} />
    </>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    line-height: 0;
    align-items: center;
    justify-content: center;
  }

  .logo img {
    display: block;
    max-width: none;
    height: auto;
  }

  .logo-on-light {
    display: none !important;
  }

  :global(:root[data-theme='light']) .logo-on-light {
    display: block !important;
  }

  :global(:root[data-theme='light']) .logo-on-dark {
    display: none !important;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .logo-on-light {
      display: block !important;
    }

    :global(:root:not([data-theme])) .logo-on-dark {
      display: none !important;
    }
  }
</style>
