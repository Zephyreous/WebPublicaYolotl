---
import Logo from './Logo.astro';
import { NAV_LINKS, SITE, isConfigured } from '@/lib/site';

const year = new Date().getFullYear();
const socials = Object.entries(SITE.social);
---

<footer class="mt-16 border-t border-border bg-surface pb-24 md:pb-0">
  <div class="container-site grid gap-8 py-12 md:grid-cols-3">
    <div>
      <Logo width={150} />
      <p class="mt-2 text-muted">{SITE.city}</p>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="text-base font-semibold">Sitio</h2>
      <ul class="mt-3 space-y-2">
        {NAV_LINKS.map(({ href, label }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-base font-semibold">Contacto</h2>
      <ul class="mt-3 space-y-2 text-muted">
        <li>
          Correo:{' '}
          {isConfigured(SITE.email) ? (
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          ) : (
            <span class="todo">TODO</span>
          )}
        </li>
        <li>
          WhatsApp: {isConfigured(SITE.whatsapp) ? SITE.whatsapp : <span class="todo">TODO</span>}
        </li>
        {socials.map(([network, url]) => (
          <li class="capitalize">
            {network}:{' '}
            {isConfigured(url) ? (
              <a href={url} rel="noopener noreferrer">
                {url}
              </a>
            ) : (
              <span class="todo">TODO</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-muted md:flex-row md:justify-between">
      <p>
        © {year} {SITE.name}. Todos los derechos reservados.
      </p>
      <p class="flex gap-4">
        <a href="/privacidad">Aviso de privacidad</a>
        <a href="/terminos">Términos y condiciones</a>
      </p>
    </div>
  </div>
</footer>
