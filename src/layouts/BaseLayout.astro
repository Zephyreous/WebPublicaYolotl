---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Logo from '@/components/Logo.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { SITE } from '@/lib/site';
import { getSeo, type PageKey } from '@/lib/seo';
import { pageFall } from '@/lib/transitions';

interface Props {
  page: PageKey;
  /** dark: la página inicia en modo oscuro; system: sigue prefers-color-scheme. */
  defaultTheme?: 'dark' | 'system';
  noindex?: boolean;
}

const { page, defaultTheme = 'system', noindex = false } = Astro.props;
const { title, description } = getSeo(page);
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim() ?? '';
---

<!doctype html>
<html lang={SITE.lang} data-default-theme={defaultTheme} transition:animate={pageFall}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Tema: preferencia guardada > predeterminado de la página (data-default-theme) >
      prefers-color-scheme. Se ejecuta antes de pintar para evitar un destello.
      El contenido de este script NO debe variar entre páginas: su hash SHA-256 está en
      la CSP de vercel.json (npm run verify:csp lo comprueba en CI).
    -->
    <script is:inline>
      (() => {
        const html = document.documentElement;
        html.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('yolotl-theme');
        } catch {
          // Sin almacenamiento: se usa el predeterminado.
        }
        if (theme !== 'dark' && theme !== 'light') {
          theme =
            html.dataset.defaultTheme === 'dark' ||
            !window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'dark'
              : 'light';
        }
        html.dataset.theme = theme;
      })();
    </script>

    <SEO title={title} description={description} noindex={noindex} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D1F38" />

    <!-- Fuentes alojadas en el sitio (ver `fonts` en astro.config.mjs). -->
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }, { weight: 700 }]} />
    <Font cssVariable="--font-jakarta" preload={[{ weight: 800 }]} />
    <Font cssVariable="--font-jetbrains" />

    <!-- Navegación entre páginas con animación (src/lib/transitions.ts). -->
    <ClientRouter />

    {plausibleDomain && (
      <script
        is:inline
        defer
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Loader de la primera carga: solo aparece si la página tarda más de ~300ms. -->
    <div class="page-loader" role="status" aria-label="Cargando" data-page-loader>
      <div class="page-loader-mark">
        <Logo variant="isotipo" width={72} withClearspace={false} alt="" />
      </div>
      <div class="page-loader-bar" aria-hidden="true"></div>
    </div>

    <!-- Barra superior mientras llega una página por navegación interna. -->
    <div class="nav-progress" aria-hidden="true" transition:persist="nav-progress"></div>

    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      import { initMagnetic } from '@/scripts/magnetic';
      import { initNavigation } from '@/scripts/navigation';
      import { initPageLoader } from '@/scripts/page-loader';
      import { initReveal } from '@/scripts/reveal';

      // Una sola vez por sesión (los módulos no se vuelven a ejecutar al navegar).
      initPageLoader();
      initNavigation();

      // En cada página: la primera carga y cada navegación con ClientRouter.
      document.addEventListener('astro:page-load', () => {
        void initReveal();
        initMagnetic();
      });
    </script>
  </body>
</html>
