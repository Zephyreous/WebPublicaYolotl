---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { SITE } from '@/lib/site';
import { getSeo, type PageKey } from '@/lib/seo';

interface Props {
  page: PageKey;
  /** dark: la página inicia en modo oscuro; system: sigue prefers-color-scheme. */
  defaultTheme?: 'dark' | 'system';
  noindex?: boolean;
}

const { page, defaultTheme = 'system', noindex = false } = Astro.props;
const { title, description } = getSeo(page);
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim() ?? '';
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Tema: preferencia guardada > predeterminado de la página > prefers-color-scheme.
      Se ejecuta antes de pintar para evitar un destello del tema equivocado.
    -->
    <script is:inline define:vars={{ defaultTheme }}>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('yolotl-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        } else if (defaultTheme === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        } else {
          document.documentElement.dataset.theme = window.matchMedia(
            '(prefers-color-scheme: light)',
          ).matches
            ? 'light'
            : 'dark';
        }
      } catch {
        if (defaultTheme === 'dark') document.documentElement.dataset.theme = 'dark';
      }
    </script>

    <SEO title={title} description={description} noindex={noindex} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D1F38" />

    <!-- Fuentes desde Google Fonts con font-display: swap. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
    />
    <!--
      Respaldo: si Google Fonts no está disponible o se prefiere no depender de terceros,
      alojar las fuentes en el propio sitio:
        npm install @fontsource-variable/inter @fontsource/plus-jakarta-sans @fontsource/jetbrains-mono
      y en este archivo:
        import '@fontsource-variable/inter';
        import '@fontsource/plus-jakarta-sans/700.css';
        import '@fontsource/plus-jakarta-sans/800.css';
        import '@fontsource/jetbrains-mono/400.css';
      Mientras tanto, las pilas de --font-* en global.css caen en Montserrat, DM Sans,
      Fira Code o la fuente del sistema.
    -->

    {plausibleDomain && (
      <script
        is:inline
        defer
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Aparición al hacer scroll: [data-reveal] recibe .is-visible al entrar en pantalla.
      // El CSS solo oculta esos elementos con JS activo y sin prefers-reduced-motion.
      const targets = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        targets.forEach((el) => observer.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
