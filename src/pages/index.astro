---
import Logo from '@/components/Logo.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProductPOS from '@/components/ProductPOS.astro';
import CaseCarousel from '@/components/CaseCarousel.astro';
import { PAGES } from '@/lib/seo';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const casos = (await getCollection('casos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<BaseLayout page="inicio" defaultTheme="dark">
  <Hero
    badge="Software a la medida & POS con IA para negocios locales"
    title={PAGES.inicio.title}
    subtitle="Creamos software a la medida, sistemas punto de venta y automatizaciones inteligentes para acelerar el crecimiento de pequeñas y medianas empresas."
    cta={{ href: '/contacto', label: 'Pide una demo' }}
    secondary={{ href: '/servicios', label: 'Ver servicios' }}
  >
    <div slot="visual" class="float card overflow-hidden p-0">
      <img
        src="/brand/Banner.svg"
        width="1200"
        height="630"
        alt="Yolotl Labs - Plataforma de software e innovación"
        class="w-full h-auto block"
        loading="eager"
      />
    </div>
  </Hero>

  <section class="container-site py-16" aria-labelledby="servicios-titulo">
    <div class="flex items-center gap-3" data-reveal>
      <Logo variant="isotipo" width={28} withClearspace={false} alt="" />
      <h2 id="servicios-titulo" class="text-3xl">
        Servicios
      </h2>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {servicios.map((servicio) => (
        <ServiceCard title={servicio.data.title} summary={servicio.data.summary} />
      ))}
    </div>
    <p class="mt-6">
      <a href="/servicios" class="link-arrow">
        Conoce todos los servicios
      </a>
    </p>
  </section>

  <section class="border-y border-border bg-surface py-16" aria-labelledby="pos-titulo">
    <div class="container-site">
      <div class="flex items-center gap-3" data-reveal>
        <img
          src="/brand/Icono.svg"
          width="32"
          height="32"
          alt=""
          class="rounded-lg"
          aria-hidden="true"
        />
        <h2 id="pos-titulo" class="text-3xl">
          Punto de venta para talleres de motos
        </h2>
      </div>
      <p class="mt-3 max-w-2xl text-muted" data-reveal>
        Diseñado específicamente para el flujo de trabajo de talleres mecánicos: control de
        refacciones, cobranza ágil y diagnóstico asistido por IA.
      </p>
      <div class="mt-8">
        <ProductPOS compact headingLevel="h3" />
      </div>
      <p class="mt-6">
        <a href="/producto-pos" class="link-arrow">
          Ver el producto POS
        </a>
      </p>
    </div>
  </section>

  <section class="container-site py-16" aria-labelledby="casos-titulo">
    <div class="flex items-center gap-3" data-reveal>
      <Logo variant="isotipo" width={28} withClearspace={false} alt="" />
      <h2 id="casos-titulo" class="text-3xl">
        Casos de estudio
      </h2>
    </div>
    <div class="mt-8" data-reveal>
      <CaseCarousel entries={casos} />
    </div>
    <p class="mt-6">
      <a href="/casos" class="link-arrow">
        Ver todos los casos
      </a>
    </p>
  </section>

  <!-- Banda final con el fondo decorado: va sobre --color-bg, no dentro de una tarjeta,
       porque sobre navy-surface el destello bajaría el contraste del texto. -->
  <section class="bg-tech border-y border-border" aria-labelledby="cta-titulo">
    <div class="container-site py-20 text-center md:py-24" data-reveal>
      <img
        src="/brand/Icono.svg"
        width="64"
        height="64"
        alt=""
        class="float mx-auto rounded-2xl"
        aria-hidden="true"
      />
      <h2 id="cta-titulo" class="mx-auto mt-6 max-w-2xl text-3xl md:text-5xl">
        ¿Listo para digitalizar tu negocio?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
        Platiquemos sobre tus retos operativos y diseñemos una solución a tu medida.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contacto" class="btn-cta">
          Pide una demo
        </a>
        <a href="/producto-pos" class="btn-secondary">
          Conoce el POS
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
