---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProductPOS from '@/components/ProductPOS.astro';
import CaseCard from '@/components/CaseCard.astro';
import { PAGES } from '@/lib/seo';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const casos = (await getCollection('casos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<BaseLayout page="inicio" defaultTheme="dark">
  <Hero
    title={PAGES.inicio.title}
    subtitle="TODO: subtítulo de una o dos líneas sobre qué hace Yolotl Labs y para quién."
    cta={{ href: '/contacto', label: 'Pide una demo' }}
    secondary={{ href: '/servicios', label: 'Ver servicios' }}
  />

  <section class="container-site py-16" aria-labelledby="servicios-titulo">
    <h2 id="servicios-titulo" class="text-3xl">
      Servicios
    </h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {servicios.map((servicio) => (
        <ServiceCard title={servicio.data.title} summary={servicio.data.summary} />
      ))}
    </div>
    <p class="mt-6">
      <a href="/servicios">Conoce todos los servicios</a>
    </p>
  </section>

  <section class="border-y border-border bg-surface py-16" aria-labelledby="pos-titulo">
    <div class="container-site">
      <h2 id="pos-titulo" class="text-3xl">
        Punto de venta para talleres de motos
      </h2>
      <p class="mt-3 max-w-2xl text-muted">
        TODO: una línea sobre el POS y el problema que resuelve en los talleres.
      </p>
      <div class="mt-8">
        <ProductPOS compact headingLevel="h3" />
      </div>
      <p class="mt-6">
        <a href="/producto-pos">Ver el producto POS</a>
      </p>
    </div>
  </section>

  <section class="container-site py-16" aria-labelledby="casos-titulo">
    <h2 id="casos-titulo" class="text-3xl">
      Casos de estudio
    </h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {casos.map((caso) => (
        <CaseCard entry={caso} />
      ))}
    </div>
    <p class="mt-6">
      <a href="/casos">Ver todos los casos</a>
    </p>
  </section>

  <section class="container-site pb-8" aria-labelledby="cta-titulo">
    <div class="card md:flex md:items-center md:justify-between">
      <div>
        <h2 id="cta-titulo" class="text-2xl">
          ¿Listo para digitalizar tu negocio?
        </h2>
        <p class="mt-2 text-muted">TODO: frase corta de cierre con la propuesta de valor.</p>
      </div>
      <a href="/contacto" class="btn-cta mt-6 md:mt-0">
        Pide una demo
      </a>
    </div>
  </section>
</BaseLayout>
