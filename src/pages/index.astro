---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProductPOS from '@/components/ProductPOS.astro';
import CaseCard from '@/components/CaseCard.astro';
import { PAGES } from '@/lib/seo';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const casos = (await getCollection('casos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<BaseLayout page="inicio" defaultTheme="dark">
  <Hero
    badge="Software a la medida & POS con IA para negocios locales"
    title={PAGES.inicio.title}
    subtitle="Creamos software a la medida, sistemas punto de venta y automatizaciones inteligentes para acelerar el crecimiento de pequeñas y medianas empresas."
    cta={{ href: '/contacto', label: 'Pide una demo' }}
    secondary={{ href: '/servicios', label: 'Ver servicios' }}
  >
    <div slot="visual" class="card overflow-hidden p-0 border border-border">
      <img
        src="/brand/Banner.svg"
        width="1200"
        height="630"
        alt="Yolotl Labs - Plataforma de software e innovación"
        class="w-full h-auto block"
        loading="eager"
      />
    </div>
  </Hero>

  <section class="container-site py-16" aria-labelledby="servicios-titulo">
    <div class="flex items-center gap-3">
      <img src="/brand/Isotipo.svg" width="28" height="28" alt="" aria-hidden="true" />
      <h2 id="servicios-titulo" class="text-3xl">
        Servicios
      </h2>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {servicios.map((servicio) => (
        <ServiceCard title={servicio.data.title} summary={servicio.data.summary} />
      ))}
    </div>
    <p class="mt-6">
      <a href="/servicios">Conoce todos los servicios</a>
    </p>
  </section>

  <section class="border-y border-border bg-surface py-16" aria-labelledby="pos-titulo">
    <div class="container-site">
      <div class="flex items-center gap-3">
        <img
          src="/brand/Icono.svg"
          width="32"
          height="32"
          alt=""
          class="rounded-lg"
          aria-hidden="true"
        />
        <h2 id="pos-titulo" class="text-3xl">
          Punto de venta para talleres de motos
        </h2>
      </div>
      <p class="mt-3 max-w-2xl text-muted">
        Diseñado específicamente para el flujo de trabajo de talleres mecánicos: control de
        refacciones, cobranza ágil y diagnóstico asistido por IA.
      </p>
      <div class="mt-8">
        <ProductPOS compact headingLevel="h3" />
      </div>
      <p class="mt-6">
        <a href="/producto-pos">Ver el producto POS</a>
      </p>
    </div>
  </section>

  <section class="container-site py-16" aria-labelledby="casos-titulo">
    <div class="flex items-center gap-3">
      <img src="/brand/Isotipo.svg" width="28" height="28" alt="" aria-hidden="true" />
      <h2 id="casos-titulo" class="text-3xl">
        Casos de estudio
      </h2>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {casos.map((caso) => (
        <CaseCard entry={caso} />
      ))}
    </div>
    <p class="mt-6">
      <a href="/casos">Ver todos los casos</a>
    </p>
  </section>

  <section class="container-site pb-8" aria-labelledby="cta-titulo">
    <div class="card md:flex md:items-center md:justify-between">
      <div class="flex items-start gap-4">
        <img
          src="/brand/Icono.svg"
          width="48"
          height="48"
          alt=""
          class="hidden sm:block rounded-xl shrink-0"
          aria-hidden="true"
        />
        <div>
          <h2 id="cta-titulo" class="text-2xl">
            ¿Listo para digitalizar tu negocio?
          </h2>
          <p class="mt-2 text-muted">
            Platiquemos sobre tus retos operativos y diseñemos una solución a tu medida.
          </p>
        </div>
      </div>
      <a href="/contacto" class="btn-cta mt-6 md:mt-0 shrink-0">
        Pide una demo
      </a>
    </div>
  </section>
</BaseLayout>
