---
import Logo from '@/components/Logo.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { PAGES } from '@/lib/seo';
import { SITE, isConfigured, whatsappUrl } from '@/lib/site';

const wa = whatsappUrl();
---

<BaseLayout page="contacto">
  <div class="container-site grid gap-12 py-16 md:grid-cols-2">
    <div data-reveal="left">
      <span class="inline-flex items-center gap-2 rounded-full border border-border px-3 py-1.5 text-sm font-semibold">
        <Logo variant="isotipo" width={18} withClearspace={false} alt="" />
        Contacto Directo
      </span>
      <h1 class="mt-4 text-4xl md:text-5xl">{PAGES.contacto.title}</h1>
      <p class="mt-6 text-lg text-muted">
        ¿Tienes un proyecto en mente o quieres conocer en vivo nuestro sistema de punto de venta?
        Escríbenos y con gusto agendamos una llamada o demo personalizada.
      </p>
      <dl class="mt-8 space-y-4">
        <div>
          <dt class="font-semibold">Ciudad</dt>
          <dd class="text-muted">{SITE.city}</dd>
        </div>
        <div>
          <dt class="font-semibold">Correo</dt>
          <dd class="text-muted">
            {isConfigured(SITE.email) ? (
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            ) : (
              <span class="todo">TODO</span>
            )}
          </dd>
        </div>
        <div>
          <dt class="font-semibold">WhatsApp</dt>
          <dd class="text-muted">
            {wa ? (
              <a href={wa} target="_blank" rel="noopener noreferrer">
                Escríbenos por WhatsApp
              </a>
            ) : (
              <span class="todo">TODO</span>
            )}
          </dd>
        </div>
      </dl>

      <div class="mt-10 card flex items-center gap-4 border border-border p-6">
        <img
          src="/brand/Icono.svg"
          width="56"
          height="56"
          alt="Yolotl Labs"
          class="shrink-0 rounded-xl"
        />
        <div>
          <h2 class="text-base font-bold">Atención personalizada</h2>
          <p class="text-sm text-muted">
            Ingeniería directa con los creadores del software, sin intermediarios.
          </p>
        </div>
      </div>
    </div>

    <div id="formulario" data-reveal="right">
      <h2 class="sr-only">Formulario de contacto</h2>
      <ContactForm />
    </div>
  </div>
</BaseLayout>
