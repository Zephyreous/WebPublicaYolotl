---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Logo from '@/components/Logo.astro';
import { PAGES } from '@/lib/seo';

const principles = [
  {
    title: 'Calidad',
    description:
      'Revisamos y probamos cada entrega. Un sistema de calidad es el que funciona igual de bien el primer día que dentro de varios años.',
  },
  {
    title: 'Funcionalidad',
    description:
      'Construimos soluciones completamente funcionales, pensadas para el uso diario de tu equipo y no solo para verse bien.',
  },
  {
    title: 'Herramientas inteligentes',
    description:
      'Usamos tecnología moderna y herramientas inteligentes donde aportan valor real: menos trabajo manual y mejores decisiones.',
  },
  {
    title: 'Comunicación clara',
    description:
      'Hablamos sin tecnicismos innecesarios, te mantenemos al tanto del avance y acordamos cada decisión importante contigo.',
  },
];

const steps = [
  {
    title: 'Entendemos el problema',
    description:
      'Escuchamos cómo opera tu empresa e identificamos qué problema hay que resolver y qué resultado esperas.',
  },
  {
    title: 'Diseñamos la solución',
    description:
      'Definimos el alcance, la arquitectura y las prioridades antes de desarrollar, para que no haya sorpresas.',
  },
  {
    title: 'Desarrollamos y probamos',
    description:
      'Construimos por etapas, con revisiones periódicas y pruebas en cada paso para asegurar un sistema robusto.',
  },
  {
    title: 'Entregamos y acompañamos',
    description:
      'Ponemos la solución en marcha, capacitamos a tu equipo y seguimos disponibles para mantenerla y hacerla crecer.',
  },
];
---

<BaseLayout page="nosotros">
  <Hero
    badge="Ingeniería y corazón mexicano"
    title={PAGES.nosotros.title}
    subtitle="Somos un estudio de ingeniería con sede en Puebla, México. Resolvemos problemas reales de las empresas con soluciones de calidad, robustas y completamente funcionales."
    cta={{ href: '/contacto/', label: 'Contáctanos' }}
  />

  <section class="container-site py-16" aria-labelledby="quienes-titulo">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <div class="flex items-center gap-3">
          <Logo variant="isotipo" width={28} withClearspace={false} alt="" />
          <h2 id="quienes-titulo" class="text-3xl">
            Quiénes somos
          </h2>
        </div>
      </div>
      <div class="space-y-4 text-lg text-muted md:col-span-7" data-reveal>
        <p>
          Yolotl Labs nace con una idea sencilla: la tecnología debe resolver problemas, no
          crearlos. Por eso cada proyecto empieza por entender a fondo la operación de nuestros
          clientes y lo que necesitan lograr.
        </p>
        <p>
          Diseñamos y desarrollamos sitios, aplicaciones y sistemas a la medida, apoyados en
          herramientas inteligentes. Nuestro compromiso es entregar soluciones que funcionen de
          principio a fin, con la calidad necesaria para sostener el día a día de una empresa.
        </p>
        <p>
          Trabajamos de cerca con cada cliente, sin intermediarios: quien escucha tu problema es el
          mismo equipo que lo resuelve.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-surface py-16" aria-labelledby="principios-titulo">
    <div class="container-site">
      <div class="flex items-center gap-3" data-reveal>
        <Logo variant="isotipo" width={28} withClearspace={false} alt="" />
        <h2 id="principios-titulo" class="text-3xl">
          Lo que nos define
        </h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {principles.map((principle) => (
          <article
            class="card card-hover flex h-full flex-col border-t-4 bg-bg"
            data-reveal="scale"
            style="border-top-color: var(--color-border-accent);"
          >
            <h3 class="text-xl">{principle.title}</h3>
            <p class="mt-3 text-muted">{principle.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-site py-16" aria-labelledby="proceso-titulo">
    <div class="flex items-center gap-3" data-reveal>
      <Logo variant="isotipo" width={28} withClearspace={false} alt="" />
      <h2 id="proceso-titulo" class="text-3xl">
        Cómo trabajamos
      </h2>
    </div>
    <ol class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="card flex h-full flex-col" data-reveal>
          <span class="font-mono text-sm font-semibold text-muted" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-2 text-xl">{step.title}</h3>
          <p class="mt-3 text-muted">{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Banda final con el fondo decorado: va sobre --color-bg (ver contraste en tests). -->
  <section class="bg-tech border-y border-border" aria-labelledby="nosotros-cta-titulo">
    <div class="container-site py-20 text-center md:py-24" data-reveal>
      <h2 id="nosotros-cta-titulo" class="mx-auto max-w-2xl text-3xl md:text-5xl">
        ¿Tienes un problema que resolver?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
        Cuéntanos qué necesitas y te proponemos una solución de calidad y completamente funcional.
      </p>
      <div class="mt-8 flex justify-center">
        <a href="/contacto/" class="btn-cta">
          Contáctanos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
