---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PAGES } from '@/lib/seo';
---

<BaseLayout page="gracias" noindex>
  <div class="container-site max-w-2xl py-24 text-center">
    <div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-2xl border border-border bg-surface">
      <img src="/brand/Icono.svg" width="64" height="64" alt="Yolotl Labs" class="rounded-xl" />
    </div>
    <h1 class="text-4xl">{PAGES.gracias.title}</h1>
    <p class="mt-6 text-lg text-muted">
      Gracias por escribirnos. Nos pondremos en contacto contigo a la brevedad para dar seguimiento
      a tu solicitud.
    </p>
    <a href="/" class="btn-secondary mt-8">
      Volver al inicio
    </a>
  </div>
</BaseLayout>
