---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CaseCarousel from '@/components/CaseCarousel.astro';
import { PAGES } from '@/lib/seo';

const casos = (await getCollection('casos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout page="casos">
  <Hero
    badge="Proyectos & Resultados Reales"
    title={PAGES.casos.title}
    subtitle="Conoce cómo acompañamos a negocios locales a transformar sus procesos manuales en plataformas automatizadas y eficientes."
  />

  <div class="container-site py-16" data-reveal>
    <CaseCarousel entries={casos} headingLevel="h2" />
  </div>
</BaseLayout>
