---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ProductPOS from '@/components/ProductPOS.astro';
import { PAGES } from '@/lib/seo';
---

<BaseLayout page="productoPos">
  <Hero
    badge="SaaS Especializado para Talleres de Motos"
    title={PAGES.productoPos.title}
    subtitle="Control integral de órdenes de servicio, inventario de refacciones y asistente inteligente para acelerar las ventas y la rentabilidad de tu taller."
    cta={{ href: '/contacto', label: 'Pide una demo' }}
    secondary={{ href: '#precio', label: 'Ver precio' }}
  />

  <div class="container-site py-16">
    <ProductPOS />
  </div>
</BaseLayout>
