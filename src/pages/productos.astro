---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { PAGES } from '@/lib/seo';
---

<BaseLayout page="productos">
  <Hero
    badge="Productos Yolotl Labs"
    title={PAGES.productos.title}
    subtitle="Herramientas digitales desarrolladas por Yolotl Labs para simplificar la operación de tu empresa."
    cta={{ href: '/contacto/', label: 'Contáctanos' }}
  />

  <section class="container-site py-16" aria-labelledby="productos-pronto-titulo">
    <div class="card mx-auto max-w-2xl text-center" data-reveal>
      <h2 id="productos-pronto-titulo" class="text-2xl">
        Productos en preparación
      </h2>
      <p class="mt-3 text-muted">
        Pronto presentaremos nuestros productos. Escríbenos si quieres conocerlos antes.
      </p>
    </div>
  </section>
</BaseLayout>
